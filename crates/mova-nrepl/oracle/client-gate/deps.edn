;; Classpath of the client gate: released nREPL 1.8.0 + Clojure 1.13.0-alpha6 (as the wire goldens),
;; the JVM client-side tests of this repo, and their test libraries.
;; `run.sh` adds the test directory (NREPL_SRC/test/clojure) with -Sdeps.
{:paths ["."]
 :deps {nrepl/nrepl {:mvn/version "1.8.0"}
        org.clojure/clojure {:mvn/version "1.13.0-alpha6"}
        com.github.ivarref/locksmith {:mvn/version "0.1.9"}
        com.hypirion/io {:mvn/version "0.3.1"}
        commons-net/commons-net {:mvn/version "3.10.0"}
        org.clojure/test.check {:mvn/version "1.1.1"}
        nubank/matcher-combinators {:mvn/version "3.9.1" :exclusions [org.clojure/clojure]}}}
