{
 "name": "g02_stdin_eof",
 "doc": "empty stdin closes *in* for that session",
 "sessions": [
  "s1"
 ],
 "steps": [
  {
   "send": {
    "op": "eval",
    "id": "12",
    "code": "(slurp *in*)",
    "session": "$s1"
   },
   "await": "need-input",
   "timeout": 3
  },
  {
   "send": {
    "op": "stdin",
    "id": "13",
    "session": "$s1",
    "stdin": ""
   }
  },
  {
   "wait": 0.5
  },
  {
   "send": {
    "op": "eval",
    "id": "14",
    "code": "(read-line)",
    "session": "$s1"
   },
   "timeout": 3
  },
  {
   "send": {
    "op": "eval",
    "id": "15",
    "code": "(+ 1 2)",
    "session": "$s1"
   }
  }
 ],
 "settle": 0.5
}