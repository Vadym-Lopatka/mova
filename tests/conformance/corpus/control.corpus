;; control.corpus -- if/when/cond/and/or/let/loop-recur/threading macros/
;; ->/->>/if-let/when-let/dotimes/try/catch/quote/quasiquote. One session.
;; Quasiquote forms avoid bare symbols in template position (real Clojure
;; auto-namespace-qualifies them; plain `quote` does not, so symbol-bearing
;; forms use `quote`/`'` instead).
(if true 1 2)
(if false 1 2)
(if true 1)
(if false 1)
(if (> 3 2) :yes :no)
(if nil :a :b)
(if 0 :truthy :falsy)
(when true 1)
(when false 1)
(when (> 5 3) :yes)
(when-not false :ran)
(when-not true :ran)
(cond)
(cond true 1)
(cond false 1 true 2)
(cond false 1 false 2 :else 3)
(cond (= 1 2) :a (= 1 1) :b :else :c)
(if-not false :a :b)
(if-not true :a :b)
(if-not false :only-then)
(and)
(and 1)
(and 1 2 3)
(and 1 nil 3)
(and true true false)
(or)
(or nil)
(or nil false 3)
(or 1 2)
(or nil nil nil)
(let [x 1] x)
(let [x 1 y 2] (+ x y))
(let [x 1] (let [x 2] x))
(let [x 1] (let [y (+ x 1)] (+ x y)))
(loop [i 0 acc 0] (if (< i 5) (recur (inc i) (+ acc i)) acc))
(loop [n 10 acc 1] (if (zero? n) acc (recur (dec n) (* acc n))))
(loop [] :done)
((fn [x] (* x x)) 5)
((fn [x y] (+ x y)) 2 3)
(let [f (fn fact [n] (if (<= n 1) 1 (* n (fact (dec n)))))] (f 5))
(-> 5 inc inc)
(-> 5 (+ 3) (* 2))
(-> [1 2 3] first inc)
(-> {:a 1} :a inc)
(->> [1 2 3] (map inc) (reduce +))
(->> 5 (+ 1) (* 2))
(-> 1 (+ 2) (- 1))
(if-let [x 5] (inc x) :none)
(if-let [x nil] (inc x) :none)
(if-let [x false] :truthy :falsy-or-nil)
(when-let [x 5] (* x 2))
(when-let [x nil] (* x 2))
(dotimes [i 3] i)
(let [a (atom 0)] (dotimes [i 5] (swap! a + i)) @a)
(let [a (atom [])] (dotimes [i 3] (swap! a conj i)) @a)
(try 42)
(try (+ 1 2))
(try (+ 1 2) (finally nil))
(try (throw "boom") (catch e e))
(try (/ 1 0) (catch e :caught))
(quote (1 2 3))
'(1 2 3)
'(a b c)
'(a (b c) d)
(quote a)
(first '(a b c))
(= '(1 2 3) (list 1 2 3))
`(1 2 3)
`(1 2 ~(+ 1 2))
`[1 2 ~(* 2 3)]
`(:a :b ~(keyword "c"))
`(1 ~@[2 3] 4)
(let [x 10] `(:a ~x :b))
(deref (atom 5))
@(atom 5)
(let [a (atom 1)] (swap! a inc) @a)
(let [a (atom 1)] (reset! a 99) @a)
(let [a (atom {:count 0})] (swap! a update :count inc) (:count @a))
(identity 42)
(identity nil)
(second [1 2 3])
(second '(1 2 3))
((constantly 7) 1 2 3)
((complement even?) 3)
((complement even?) 4)
(do 1 2 3)
(do)
(let [x (do 1 2 3)] x)
