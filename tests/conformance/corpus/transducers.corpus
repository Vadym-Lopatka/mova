;; transducers.corpus -- the transducer protocol slice landed C13 (wave:
;; sequences/transducers, session 7b, branch compat/c13-sequences):
;; reduced/reduced?/unreduced/ensure-reduced/completing/transduce +
;; comp-of-transducers + the 0-arity TRANSDUCER form of every core seq fn
;; Clojure overloads with one. PROMOTED FROM tests/conformance/pending/
;; transducers.corpus (all 34 forms conformed once the slice landed --
;; pending file deleted, see this branch's own final report). Every form
;; below applies the transducer immediately (via into/transduce) rather
;; than printing the bare transducer value, since a bare transducer is a
;; closure and prints as a non-deterministic #object[...].
;; transducers.corpus -- mova has ZERO transducer arities: every core seq
;; function that Clojure overloads with a 1-arg "returns a transducer" form
;; errors in mova (arity error, since mova only implements the seq-consuming
;; N-arg forms). This corpus pins the 1-arg arity of all 20 functions named
;; in the audit, plus the transducer-consuming machinery (sequence,
;; transduce, eduction, completing, reduced/reduced?/ensure-reduced/
;; unreduced) and comp-of-transducers (whose L-to-R ordering is the OPPOSITE
;; of function comp's R-to-L ordering -- pinned explicitly at the bottom).
;; Every form below applies the transducer immediately (via into/sequence/
;; transduce) rather than printing the bare transducer value, since a bare
;; transducer is a closure and prints as a non-deterministic #object[...].
;; Goldens: real Clojure 1.13.0-alpha6 via tools/jvm-runner.clj-style
;; runner (see this campaign's session notes). mova: target/release/mova -e,
;; one process per form (all forms are self-contained -- no cross-form
;; session state needed).
;;
;; compat/c10-datastructures (2026-08-21): `reduced`/`reduced?` now exist
;; (Value::Reduced) and `deref`/`@` unwraps one -- `(reduced? (reduced 1))`,
;; `(reduced? 1)`, and `(deref (reduced 42))` moved to tests/conformance/
;; corpus/higher-order.corpus. `ensure-reduced`/`unreduced` are still
;; unimplemented -- their three forms below stay pending.

;; -- the 20 named transducer arities, one each --
(into [] (map inc) [1 2 3])
(into [] (filter even?) [1 2 3 4 5])
(into [] (remove even?) [1 2 3 4 5])
(into [] (take 3) [1 2 3 4 5])
(into [] (take-while even?) [2 4 5 6])
(into [] (take-nth 2) [1 2 3 4 5 6])
(into [] (drop 2) [1 2 3 4 5])
(into [] (drop-while even?) [2 4 5 6])
(into [] (replace {1 :a 2 :b}) [1 2 3])
(into [] (partition-by even?) [1 1 2 2 3])
(into [] (partition-all 2) [1 2 3 4 5])
(into [] (keep (fn [x] (when (even? x) (* x x)))) [1 2 3 4])
(into [] (keep-indexed (fn [i x] (when (even? i) x))) [:a :b :c :d])
(into [] (map-indexed vector) [:a :b :c])
(into [] (mapcat range) [1 2 3])
(into [] (distinct) [1 2 1 3 2 4])
(into [] (dedupe) [1 1 2 2 1 1 3])
(into [] (interpose 0) [1 2 3])
(into [] (random-sample 1.0) [1 2 3])
(into [] (random-sample 0.0) [1 2 3])
(into [] cat [[1 2] [3 4] [5]])
(transduce (halt-when even?) conj [] [1 3 5 4 7])
(transduce (halt-when even? (fn [res x] (conj res :halted))) conj [] [1 3 5 4 7])

;; -- consuming machinery --
(transduce (map inc) + [1 2 3])
(transduce (comp (map inc) (filter even?)) conj [] [1 2 3 4 5])
(transduce (map inc) (completing +) 0 [1 2 3])
(transduce (map inc) (completing + (fn [acc] (* acc 2))) 0 [1 2 3])
(reduced? (ensure-reduced 1))
(reduced? (ensure-reduced (reduced 1)))
(unreduced (reduced 5))
(unreduced 5)

;; -- comp ordering: transducer comp is LEFT-to-RIGHT (map inc happens
;; before map *10), unlike function comp's right-to-left -- swapping the
;; two args changes the result, proving the ordering rather than asserting it.
(into [] (comp (map inc) (map (fn [x] (* x 10)))) [1 2 3])
(into [] (comp (map (fn [x] (* x 10))) (map inc)) [1 2 3])
