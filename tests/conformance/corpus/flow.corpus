;;ENGINE jvm-flow
;; flow.corpus -- core.async.flow semantics, JVM-verified against REAL
;; clojure.core.async.flow v1.9.808-alpha1 (see tools/jvm-flow-runner.clj +
;; tools/gen-golden.bb's `;;ENGINE jvm-flow` mechanism -- babashka does not
;; ship core.async.flow at all, so unlike every other *.corpus file here,
;; this one's golden is generated by shelling out ONCE to a real JVM
;; `clojure` process instead of in-process babashka).
;;
;; Session model: same as every other corpus file -- one file, one session,
;; forms may build on `def`s made earlier in the file. See FLOW-DESIGN.md
;; for the contract, `core/flow.mova` + `src/builtins/flow.rs` for mova's
;; implementation.
;;
;; SURFACE BRIDGING (read before adding forms -- these are the traps that
;; make a form non-portable between mova and real JVM core.async.flow even
;; though both understand "the same" scenario):
;;   - `flow/create-flow` etc: mova has these as flat global symbol names;
;;     tools/jvm-flow-runner.clj requires `clojure.core.async.flow` under
;;     the alias `flow`, so the SAME literal text `(flow/create-flow ...)`
;;     resolves correctly on both engines. Same story for `chan`/`>!!`/`<!!`
;;     /`close!`/`poll!`/`timeout` etc via the runner's `:refer` list.
;;   - Namespaced flow keywords: ALWAYS write the fully-qualified
;;     `:clojure.core.async.flow/pid` form, NEVER `::flow/pid` -- mova's
;;     reader has no `::` namespace-alias resolution (see flow.rs's module
;;     doc), so `::flow/pid` would read as a mova keyword literally named
;;     `:flow/pid`, silently NOT the same value as what upstream's `::flow`
;;     alias expands to.
;;   - `def` returns a Var on the JVM (`#'jvm-flow-runner/foo`, unprintable-
;;     comparably) but the bare VALUE on mova (see `core/flow.mova`'s
;;     module doc reference to eval_def) -- every `def`-ing form below is
;;     wrapped `(do (def ...) ... nil)` so its golden line is always
;;     `OK\tnil` on both engines, never the def's own return value.
;;   - `flow/resume`/`flow/pause` return `true` on the JVM (the underlying
;;     `>!!` succeeding) but `nil` on mova (native_resume/native_pause
;;     just `Ok(Value::Nil)`) -- never left as a bare form result; always
;;     wrapped in a `do` alongside the thing actually being asserted, or
;;     discarded via a trailing `nil`.
;;   - `flow/inject` returns a future/Future object (unprintable-comparably
;;     -- a `java.util.concurrent.FutureTask` vs mova's `Value::Future`) --
;;     NEVER printed raw; always `(do (flow/inject ...) nil)`, relying on a
;;     later blocking channel read to naturally wait for delivery instead.
;;   - `flow/start` returns `{:report-chan c :error-chan c}` -- a raw
;;     channel is unprintable-comparably too, so the result is always
;;     captured via `def` (wrapped nil) rather than printed.
;;   - error-chan / ping-reply maps: NEVER pr-str the whole map (multi-key
;;     map iteration order is unspecified, and `:ex`/`:state` print as
;;     totally unrelated per-engine object dumps) -- always pull out
;;     individual STABLE keys (`:cid`/`:msg`/`:op`, or `:status`/`:count`)
;;     into a plain vector via bare keyword access or `get-in`, never
;;     `select-keys` (mova has no `select-keys` builtin).
;;   - `flow/ping`/`flow/ping-proc` never called with an explicit
;;     timeout-ms: mova's is a positional arg (`(flow/ping fl 1000)`) but
;;     upstream's is a trailing kwarg (`(ping g :timeout-ms 1000)`) --
;;     omitting it entirely uses each engine's own 1000ms default on both,
;;     dodging the calling-convention mismatch altogether.
;;   - Fan-out to >1 connection per :out, and multi-entry output maps from
;;     a single `transform` call, are used sparingly and only where the
;;     assertion reads each destination channel to quiescence via blocking
;;     takes (never `poll!`s a channel expected to be "not yet" populated
;;     unless the reason is structural -- e.g. proc genuinely paused, or an
;;     input-filter permanently excluding a cid -- never a timing race).

;; ---- create-flow: eager validation (both engines validate at create,
;;      before `start` -- see JVM's impl.clj `prep-proc`/`create-flow`
;;      building `conn-map` eagerly, and mova's native_create_flow) ----
(flow/create-flow {:procs {:a {:proc (flow/process (flow/map->step {:describe (fn [] {:ins {} :outs {:out {}}}) :transform (fn [s _ m] [s {}])}))}} :conns [[[:a :out] [:ghost :in]]]})
(flow/create-flow {:procs {:a {:proc (flow/process (flow/map->step {:describe (fn [] {:ins {} :outs {:out {}}}) :transform (fn [s _ m] [s {}])}))} :b {:proc (flow/process (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {}}) :transform (fn [s _ m] [s {}])}))}} :conns [[[:a :nope] [:b :in]]]})
(flow/create-flow {:procs {:a {:proc (flow/process (flow/map->step {:describe (fn [] {:ins {:x {}} :outs {:x {}}}) :transform (fn [s _ m] [s {}])}))}} :conns []})

;; ---- minimal 2-proc pipeline: inject -> double -> sink into an atom,
;;      quiesce by blocking-reading the expected count off the sink's own
;;      side-channel, then read the atom ----
(do (def sink-log (atom [])) (def doubler (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {:out {}}}) :transform (fn [s _ m] [s {:out [(* 2 m)]}])})) (def sink-ch (chan 20)) (def sink-step (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {}}) :transform (fn [s _ m] (swap! sink-log conj m) (>!! sink-ch m) [s {}])})) (def fl-b (flow/create-flow {:procs {:d {:proc (flow/process doubler)} :s {:proc (flow/process sink-step)}} :conns [[[:d :out] [:s :in]]]})) (def chans-b (flow/start fl-b)) (flow/resume fl-b) nil)
(do (flow/inject fl-b [:d :in] [1 2 3 4 5]) nil)
(do (<!! sink-ch) (<!! sink-ch) (<!! sink-ch) (<!! sink-ch) (<!! sink-ch))
@sink-log
(do (flow/stop fl-b) nil)

;; ---- paused-until-resume observable ordering: procs start paused (both
;;      engines document this), so injecting before `resume` is guaranteed
;;      to never be observed -- structural, not a timing race ----
(do (def relay (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {:out {}}}) :transform (fn [s _ m] [s {:out [m]}])})) (def p-sink-ch (chan 20)) (def p-sink (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {}}) :transform (fn [s _ m] (>!! p-sink-ch m) [s {}])})) (def fl-c (flow/create-flow {:procs {:r {:proc (flow/process relay)} :s {:proc (flow/process p-sink)}} :conns [[[:r :out] [:s :in]]]})) (def chans-c (flow/start fl-c)) nil)
(do (flow/inject fl-c [:r :in] [1 2 3]) nil)
(poll! p-sink-ch)
(do (flow/resume fl-c) [(<!! p-sink-ch) (<!! p-sink-ch) (<!! p-sink-ch)])
(do (flow/stop fl-c) nil)

;; ---- transform returning multiple msgs to one out: send order preserved ----
(do (def multi-step (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {:out {}}}) :transform (fn [s _ m] [s {:out [m (* m 10) (* m 100)]}])})) (def multi-sink-ch (chan 20)) (def multi-sink (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {}}) :transform (fn [s _ m] (>!! multi-sink-ch m) [s {}])})) (def fl-d (flow/create-flow {:procs {:m {:proc (flow/process multi-step)} :s {:proc (flow/process multi-sink)}} :conns [[[:m :out] [:s :in]]]})) (flow/start fl-d) (flow/resume fl-d) nil)
(do (flow/inject fl-d [:m :in] [2]) nil)
[(<!! multi-sink-ch) (<!! multi-sink-ch) (<!! multi-sink-ch)]
(do (flow/stop fl-d) nil)

;; ---- multiple outs: single-entry output maps per transform call dodge
;;      map-iteration-order nondeterminism entirely (each call emits to
;;      exactly ONE of :even/:odd, never both) ----
(do (def router (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {:even {} :odd {}}}) :transform (fn [s _ m] (if (even? m) [s {:even [m]}] [s {:odd [m]}]))})) (def even-ch (chan 20)) (def odd-ch (chan 20)) (def even-sink (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {}}) :transform (fn [s _ m] (>!! even-ch m) [s {}])})) (def odd-sink (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {}}) :transform (fn [s _ m] (>!! odd-ch m) [s {}])})) (def fl-e (flow/create-flow {:procs {:r {:proc (flow/process router)} :e {:proc (flow/process even-sink)} :o {:proc (flow/process odd-sink)}} :conns [[[:r :even] [:e :in]] [[:r :odd] [:o :in]]]})) (flow/start fl-e) (flow/resume fl-e) nil)
(do (flow/inject fl-e [:r :in] [1 2 3 4 5 6]) nil)
[(<!! even-ch) (<!! even-ch) (<!! even-ch)]
[(<!! odd-ch) (<!! odd-ch) (<!! odd-ch)]
(do (flow/stop fl-e) nil)

;; ---- error-chan: deliberate throw, stable-subset extraction, state kept
;;      across the error (v2 continues from v1's state, not restarted) ----
(do (def err-step (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {:out {}}}) :init (fn [_] {:n 0}) :transform (fn [s _ m] (if (= m :boom) (throw "kaboom") (let [s2 (update s :n inc)] [s2 {:out [(:n s2)]}])))})) (def err-sink-ch (chan 20)) (def err-sink (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {}}) :transform (fn [s _ m] (>!! err-sink-ch m) [s {}])})) (def fl-f (flow/create-flow {:procs {:e {:proc (flow/process err-step)} :s {:proc (flow/process err-sink)}} :conns [[[:e :out] [:s :in]]]})) (def chans-f (flow/start fl-f)) (flow/resume fl-f) nil)
(do (flow/inject fl-f [:e :in] [1 :boom 2]) nil)
(<!! err-sink-ch)
(do (def err-map (<!! (:error-chan chans-f))) [(:clojure.core.async.flow/cid err-map) (:clojure.core.async.flow/msg err-map) (:clojure.core.async.flow/op err-map)])
(<!! err-sink-ch)
(do (flow/stop fl-f) nil)

;; ---- ping: :status/:count only (never :ins/:outs/:state -- their exact
;;      shape is a documented per-engine deviation, see DEVIATIONS.md) ----
(do (def g-relay (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {:out {}}}) :transform (fn [s _ m] [s {:out [m]}])})) (def g-sink-ch (chan 20)) (def g-sink (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {}}) :transform (fn [s _ m] (>!! g-sink-ch m) [s {}])})) (def fl-g (flow/create-flow {:procs {:r {:proc (flow/process g-relay)} :s {:proc (flow/process g-sink)}} :conns [[[:r :out] [:s :in]]]})) (flow/start fl-g) (flow/resume fl-g) nil)
(do (flow/inject fl-g [:r :in] [1 2 3 4 5]) nil)
(do (<!! g-sink-ch) (<!! g-sink-ch) (<!! g-sink-ch) (<!! g-sink-ch) (<!! g-sink-ch))
(do (def g-reply (flow/ping fl-g)) [(get-in g-reply [:r :clojure.core.async.flow/status]) (get-in g-reply [:r :clojure.core.async.flow/count]) (get-in g-reply [:s :clojure.core.async.flow/status]) (get-in g-reply [:s :clojure.core.async.flow/count])])
(do (flow/stop fl-g) nil)

;; ---- stop: idempotent (second/third calls both settle to nil on both
;;      engines -- the FIRST real stop's own return value differs per
;;      engine (JVM: true, mova: nil), so it's discarded via `do`+nil;
;;      only the ALREADY-stopped path, which both engines agree is nil,
;;      is ever compared) ----
(do (def h-step (flow/map->step {:describe (fn [] {:ins {} :outs {}}) :transform (fn [s _ m] [s {}])})) (def fl-h (flow/create-flow {:procs {:p {:proc (flow/process h-step)}} :conns []})) (flow/start fl-h) nil)
(do (flow/stop fl-h) nil)
[(flow/stop fl-h) (flow/stop fl-h)]

;; ---- input-filter: state's `::flow/input-filter` predicate permanently
;;      restricts the read-set to one of two declared ins -- the :b
;;      channel is never read at all, so a `poll!` after quiescing on :a
;;      is structural (never-arrives), not a timing race ----
(do (def if-out-ch (chan 20)) (def if-step (flow/map->step {:describe (fn [] {:ins {:a {} :b {}} :outs {}}) :init (fn [_] {:clojure.core.async.flow/input-filter (fn [cid] (= cid :a))}) :transform (fn [s cid m] (>!! if-out-ch [cid m]) [s {}])})) (def fl-i (flow/create-flow {:procs {:f {:proc (flow/process if-step)}} :conns []})) (flow/start fl-i) (flow/resume fl-i) nil)
(do (flow/inject fl-i [:f :a] [1 2]) nil)
(do (flow/inject fl-i [:f :b] [99]) nil)
[(<!! if-out-ch) (<!! if-out-ch)]
(poll! if-out-ch)
(do (flow/stop fl-i) nil)

;; ---- fan-out (mult): one :out connected to two :ins, both receive every
;;      message in order (native mult on mova, core.async/mult upstream) ----
(do (def src-step (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {:out {}}}) :transform (fn [s _ m] [s {:out [m]}])})) (def fan-a-ch (chan 20)) (def fan-b-ch (chan 20)) (def fan-a-sink (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {}}) :transform (fn [s _ m] (>!! fan-a-ch m) [s {}])})) (def fan-b-sink (flow/map->step {:describe (fn [] {:ins {:in {}} :outs {}}) :transform (fn [s _ m] (>!! fan-b-ch m) [s {}])})) (def fl-l (flow/create-flow {:procs {:src {:proc (flow/process src-step)} :a {:proc (flow/process fan-a-sink)} :b {:proc (flow/process fan-b-sink)}} :conns [[[:src :out] [:a :in]] [[:src :out] [:b :in]]]})) (flow/start fl-l) (flow/resume fl-l) nil)
(do (flow/inject fl-l [:src :in] [1 2 3 4 5]) nil)
[(<!! fan-a-ch) (<!! fan-a-ch) (<!! fan-a-ch) (<!! fan-a-ch) (<!! fan-a-ch)]
[(<!! fan-b-ch) (<!! fan-b-ch) (<!! fan-b-ch) (<!! fan-b-ch) (<!! fan-b-ch)]
(do (flow/stop fl-l) nil)
