;; sorted-colls.corpus -- S4 (compat/s4-sorted-vecof): sorted-map/-by,
;; sorted-set/-by, sorted?, subseq/rsubseq, rseq, and vector-of. Every form
;; measured against real Clojure 1.13.0-alpha6 first (see
;; compat/sorted-vecof-probe.clj + compat/probe-oracle.out in this branch's
;; history for the full transcript) -- multi-entry sorted-map/-set literals
;; ARE safe to print directly here (unlike plain hash-map/hash-set:
;; iteration order is comparator-defined, not hash-bucket order).
;;
;; Promoted out of tests/conformance/pending/collections.corpus (the
;; sorted-collection + vector-of forms that lived there since before this
;; branch): sorted-map/-by, sorted-set/-by, sorted?, subseq, rsubseq, rseq,
;; vector-of count/into. array-map/PersistentQueue/transient forms in that
;; same pending file are NOT this branch's scope and stay pending.

;; -- sorted-map / sorted-map-by --
(sorted-map :b 2 :a 1 :c 3)
(sorted-map-by > 3 :c 1 :a 2 :b)
(sorted-map 3 :c 1 :a 2 :b)
(seq (sorted-map 3 :c 1 :a 2 :b))
(keys (sorted-map 3 :c 1 :a 2 :b))
(vals (sorted-map 3 :c 1 :a 2 :b))
(first (sorted-map 3 :c 1 :a 2 :b))
(last (sorted-map 3 :c 1 :a 2 :b))
(count (sorted-map 3 :c 1 :a 2 :b))
(contains? (sorted-map 3 :c 1 :a 2 :b) 2)
(get (sorted-map 3 :c 1 :a 2 :b) 2)
(get (sorted-map 3 :c 1 :a 2 :b) 9 :not-found)
(dissoc (sorted-map 3 :c 1 :a 2 :b) 2)
(class (sorted-map 1 2))
(pr-str (sorted-map 1 :a 2 :b))
(str (sorted-map 1 :a))
(get (sorted-map 1 :a) 1)
(find (sorted-map 1 :a 2 :b) 1)
(find (sorted-map 1 :a 2 :b) 9)

;; comparator subtleties, measured
(assoc (sorted-map 1 :a) 1.0 :b)
(keys (assoc (sorted-map 1 :a) 1.0 :b))
(= (sorted-map 1 :a 2 :b) {1 :a 2 :b})
(= {1 :a 2 :b} (sorted-map 1 :a 2 :b))
(= (hash (sorted-map 1 :a 2 :b)) (hash {1 :a 2 :b}))
(= (sorted-map-by > 1 :a) (sorted-map-by < 1 :a))

;; -- sorted-set / sorted-set-by --
(sorted-set 3 1 2)
(sorted-set-by > 3 1 2)
(sorted? (sorted-map :a 1))
(sorted? {})
(sorted? (sorted-set 1 2))
(sorted? #{1 2})
(sorted? [1 2])
(seq (sorted-set 5 4 3 2 1))
(first (sorted-set 1 2 3))
(last (sorted-set 1 2 3))
(disj (sorted-set 1 2 3) 2)
(seq (disj (sorted-set 1 2 3) 2))
(class (sorted-set 1 2))
(pr-str (sorted-set 1 2 3))
(pr-str (sorted-set-by > 1 2))
(contains? (sorted-set 1.0) 1)
(conj (sorted-set 1) 1.0)
(seq (conj (sorted-set 1) 1.0))
(= (sorted-set 1 2 3) #{1 2 3})
(= (hash (sorted-set 1 2 3)) (hash #{1 2 3}))
(seq (sorted-set-by (fn [a b] (< a b)) 3 1 2))

;; heterogeneous/incomparable keys -- errors
(sorted-set 1 "a")
(sorted-map () 1)
(assoc (sorted-map) () 1)
(sorted-set ())
(sorted-set {})
(sorted-set #{})
(sorted-set-by < 1 "a")

;; nil in a sorted collection (nil sorts least, measured)
(sorted-set [])
(sorted-set nil)
(sorted-set 1 nil)
(sorted-set nil 2)
(seq (sorted-set nil 2 1))
(sorted-set-by compare nil)
(sorted-set-by compare #{})

;; -- empty / conj preserves comparator --
(conj (empty (sorted-map 5 :e 1 :a)) [3 :c])
(seq (conj (empty (sorted-map 5 :e 1 :a)) [3 :c] [1 :a]))
(conj (empty (sorted-set 5 3 1)) 2 4)
(seq (conj (empty (sorted-set 5 3 1)) 2 4))
(empty (sorted-map-by > 5 :e 1 :a))
(seq (conj (empty (sorted-map-by > 5 :e 1 :a)) [3 :c] [1 :a] [7 :g]))

;; -- rseq --
(rseq (sorted-map :a 1 :b 2))
(rseq [1 2 3])
(rseq (sorted-set 1 2 3))

;; -- subseq / rsubseq (comparator-based, NOT calling the test fn on keys
;;    directly -- measured: works fine on keyword keys, which `>`/`<`
;;    themselves would reject) --
(subseq (sorted-map :a 1 :b 2 :c 3) > :a)
(subseq (sorted-set 1 2 3 4 5) >= 3)
(rsubseq (sorted-map :a 1 :b 2 :c 3) < :c)
(subseq (sorted-map 1 :a 2 :b 3 :c 4 :d) > 1 < 4)
(rsubseq (sorted-map 1 :a 2 :b 3 :c 4 :d) > 1 < 4)
(subseq (sorted-set 1 2 3 4 5) > 2 < 5)
(subseq (sorted-map) > 2)

;; -- vec of a sorted collection --
(vec (sorted-set 0 1 2 3))
(vec (sorted-map 1 2 3 4))

;; -- vector-of --
(vector-of :int 1 2 3)
(pr-str (vector-of :int 1 2 3))
(class (vector-of :int 1 2 3))
(= (vector-of :int 1 2 3) [1 2 3])
(= [1 2 3] (vector-of :int 1 2 3))
(= (hash (vector-of :int 1 2 3)) (hash [1 2 3]))
(count (vector-of :int 1 2 3))
(into (vector-of :long) [1 2 3])
(empty? (vector-of :int))
(vector-of :boolean)
(vector-of :byte)
(vector-of :short)
(vector-of :long)
(vector-of :float)
(vector-of :double)
(vector-of :char)

;; coercion, measured (truncating casts, char<->int-codepoint bridge)
(vector-of :byte 100)
(vector-of :byte -100)
(vector-of :byte 200)
(vector-of :byte -200)
(conj (vector-of :int) 1.5)
(vector-of :char 65)
(pr-str (vector-of :char 65))
(vector-of :int 1M 2.0 3.1)
(vector-of :int \a \b \c)

;; rejected element types, measured
(conj (vector-of :int) nil)
(vector-of :int true)
(vector-of :int {:a 1})
(vector-of :int [1 2] [3 4])
(vector-of :int '(1 2 3))
(vector-of :int #{1 2 3})
(vector-of :int "1" "2")

;; bad kind keyword, measured
(vector-of nil)
(vector-of :integer)

;; -- assoc/nth/get/peek/pop/subvec/reduce/seq/rseq/into on a typed vector --
(assoc (vector-of :int 1 2 3) 1 99)
(class (assoc (vector-of :int 1 2 3) 1 99))
(assoc (vector-of :int 1 2 3) 1 1.5)
(nth (vector-of :int 1 2 3) 1)
(get (vector-of :int 1 2 3) 1)
(get (vector-of :int 1 2 3) 9 :not-found)
(peek (vector-of :int 1 2 3))
(pop (vector-of :int 1 2 3))
(class (pop (vector-of :int 1 2 3)))
(subvec (vector-of :int 1 2 3 4 5) 1 3)
(reduce + (vector-of :int 1 2 3 4 5))
(seq (vector-of :int 1 2 3))
(rseq (vector-of :int 1 2 3))
(rseq (into (vector-of :int) (range 6)))
(into [] (vector-of :int 1 2 3))
(into (vector-of :int) [1 2 3])
(class (into (vector-of :int) [1 2 3]))
(empty (vector-of :int 1 2 3))
(class (empty (vector-of :int 1 2 3)))
(conj (empty (vector-of :int 1 2 3)) 1.9)
(into (vector-of :int) [1 2 "3"])

;; -- key / val / find / compare, general (needed for the entries above) --
(key (first (sorted-map 1 :a)))
(val (first (sorted-map 1 :a)))
(compare 1 2)
(compare [1 2] [1 2 3])
(compare "a" "b")
(compare :a :b)
