;; types.corpus -- class/type/instance?/class-level isa? (S3). Every
;; class-name row measured on 1.13.0-alpha6 (S3 probe transcripts);
;; forms whose mova class name still diverges (e.g. (class (range 3)) is
;; LongRange on the JVM, LazySeq here) stay in the pending ledger, not
;; in this file.
(class 3)
(class 1.5)
(class "s")
(class :k)
(class 'sym)
(class [1])
(class '(1 2))
(class {:a 1})
(class #{1})
(class 3N)
(class 1/2)
(class 3.0M)
(class \c)
(class true)
(class nil)
(class (map inc [1]))
(pr-str (class 3))
(instance? Long 3)
(instance? Long 1.5)
(instance? Double 1.5)
(instance? String "x")
(instance? Number 3)
(instance? Number 1.5)
(instance? Number 3N)
(instance? Number "x")
(instance? Comparable "x")
(instance? Boolean true)
(instance? Character \c)
(isa? Long Number)
(isa? String Object)
(isa? Long String)
(isa? ::hb ::ha)
(isa? [::hb2 ::hx] [::hc2 ::hy])
(isa? [::hb2] [::hc2 ::hx])
(isa? ::hx2 ::hy2)
(isa? :a :a)
(class? Long)
(class? 3)
(type 3)
(type "s")
