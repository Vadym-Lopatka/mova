;; Promoted from pending/reader.corpus (W3e-1: syntax-quote now resolves
;; free symbols against the current namespace, the way real Clojure's
;; reader does -- see src/eval/quasiquote.rs's "Namespace qualification"
;; doc). The one row left behind in the pending ledger is ``a: mova still
;; has no nested-syntax-quote depth tracking.
`(a b)
`map
`(map inc [1 2])
(let [x 1] `x)
(= `map 'clojure.core/map)
;; C3d: promoted from tests/conformance/pending/reader.corpus -- `::kw`
;; auto-resolved keywords now qualify against *ns* like real Clojure
;; (src/reader.rs's read_keyword, threaded a read-time NsContext).
::foo
(name ::foo)
(namespace ::foo)
(= ::foo :user/foo)

;; SPEC-W1 task 4: promoted from tests/conformance/pending/reader.corpus --
;; `#inst` is no longer a permissive tag-and-pass-through (which degraded
;; it into the bare payload STRING); it reads into mova's `java.util.Date`
;; shape and prints back exactly the way real Clojure's own `print-method`
;; for that class does. See src/reader.rs's `read_inst_literal` and
;; src/hostclass.rs's `parse_inst`/`format_inst`.
#inst "2020-01-01"
(inst? #inst "2020-01-01")
(inst-ms #inst "1970-01-01T00:00:00.100-00:00")
#inst "2020-01-01T05:30:00+05:30"
;; (`=` between two distinct Date values is NOT asserted here: mova
;; compares host instances by `Arc` identity, a pre-existing scope
;; decision unrelated to this task -- see value.rs's `(HostInst, HostInst)`
;; equality arm.)
