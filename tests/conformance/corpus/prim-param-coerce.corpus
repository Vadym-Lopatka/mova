;; prim-param-coerce.corpus -- D9 (docs/SPEC-PORT-PATCHES.md item 9):
;; `^long`/`^double` hints on a `fn` parameter are a CALL-BOUNDARY
;; COERCION, not an inert reflection hint. Real Clojure compiles such a fn
;; to a class with a primitive `invokePrim`, and its `invoke(Object)`
;; bridge is generated by `Compiler$HostExpr.emitUnboxArg` as
;; `checkcast java/lang/Number` followed by `RT.longCast(Object)` /
;; `RT.doubleCast(Object)` -- so the body can never observe anything but a
;; real long/double.
;;
;; That is what `clojure.test.check.generators/shrink-long`'s `(defn-
;; shrink-long [^long x] ..)` depends on when `size-bounded-bignat` hands
;; it a BigInt that fits a long; without it `(s/exercise coll? 5)` threw
;; about one run in three.
;;
;; The `checkcast` is load-bearing and makes this boundary strictly
;; NARROWER than `clojure.core`'s own casts on exactly one input: `(long
;; \a)` is `97`, but `((fn [^long x] x) \a)` is a ClassCastException,
;; because `RT.longCast`'s Character branch is never reached -- the cast
;; to Number fails first. Every row below is measured on 1.13.0-alpha6.
(do (def fl (fn [^long x] x)) :defined)
(do (def fd (fn [^double x] x)) :defined)
;; --- ^long: the RT.longCast table, per source class ---
(fl 5)
(class (fl 5))
(fl (int 7))
(fl (byte 7))
(fl (short 7))
(fl (bigint 5))
(class (fl (bigint 5)))
(fl (biginteger 5))
(fl (bigint 9223372036854775807))
(fl (bigint 9223372036854775808))
(fl (bigint 99999999999999999999999))
;; floats truncate toward zero; ##NaN goes to 0 (JLS 5.1.3), not a throw
(fl 1.5)
(fl 2.0)
(fl -1.9)
(fl (float 1.5))
(fl ##NaN)
(fl 9.223372036854775e18)
(fl 1e30)
(fl -9.3e18)
(fl ##Inf)
(fl ##-Inf)
;; Ratio goes through bigIntegerValue(), i.e. truncation toward zero
(fl 3/2)
(fl -7/2)
(fl 4/2)
;; BigDecimal matches no branch of RT.longCast and falls through to
;; longCast(doubleValue()) -- which is why the out-of-range message names
;; the DOUBLE (1.0E23), not the bigdec's own 24-digit rendering
(fl 1M)
(fl 1.5M)
(fl 1.9M)
(fl -1.9M)
(fl (bigdec 100000000000000000000000))
;; --- ^long: the checkcast-to-Number arm ---
(fl "s")
(fl \a)
(fl true)
(fl nil)
(fl [])
(fl :k)
(fl 'sym)
(fl {})
;; --- ^double: RT.doubleCast is a bare ((Number)x).doubleValue() ---
(fd 1)
(class (fd 1))
(fd (bigint 5))
(fd (bigint 99999999999999999999999))
(fd 3/2)
(fd 1.5M)
(fd (float 1.5))
(fd 1.5)
(fd "s")
(fd \a)
(fd true)
(fd nil)
(fd [])
;; --- which tags coerce, and which stay inert ---
((fn [^Long x] x) (bigint 5))
((fn [^Object x] x) (bigint 5))
((fn [^longs x] x) (bigint 5))
((fn [^objects x] x) (bigint 5))
((fn [^String x] x) 5)
;; `Compiler.primClass` tests the tag symbol's NAME alone, so the tag's
;; namespace is ignored -- and a String tag resolves the same primitives
((fn [^"long" x] x) (bigint 5))
((fn [^{:tag long} x] x) (bigint 5))
((fn [^{:tag clojure.core/long} x] x) (bigint 5))
((fn [^{:tag double} x] x) (bigint 5))
;; a hint on a DESTRUCTURING pattern is inert (the vector reaches the
;; destructuring intact instead of dying in a cast)
((fn [^long [a b]] a) [1 2])
;; --- where the boundary is, and where it is not ---
((fn [a ^long b] b) 1 (bigint 5))
((fn [^long a ^double b] [a b]) (bigint 5) (bigint 6))
((fn ([^long x] x) ([^long x ^double y] [x y])) (bigint 7))
((fn ([^long x] x) ([^long x ^double y] [x y])) (bigint 7) (bigint 8))
(apply (fn [^long x] x) [(bigint 5)])
(doall (map (fn [^long x] x) [(bigint 5) (bigint 6)]))
(letfn [(h [^long x] x)] (h (bigint 5)))
(do (defn hinted-defn [^long x] x) (hinted-defn (bigint 5)))
(do (defn- hinted-defn- [^long x] x) (hinted-defn- (bigint 5)))
;; self-`recur` stays INSIDE the body: it is not a call boundary, and the
;; JVM does not re-cast there either
((fn [^long x] (if (pos? x) (recur (dec x)) x)) (bigint 3))
;; `let`/`loop` bindings are NOT fn parameters -- their hints stay inert
(let [^long x (bigint 5)] x)
(loop [^long x (bigint 3)] x)
;; --- exception taxonomy, checked by catching the real class ---
(try (fl (bigint 99999999999999999999999)) (catch IllegalArgumentException e :iae))
(try (fl 1e30) (catch IllegalArgumentException e :iae))
(try (fl "s") (catch ClassCastException e :cce))
(try (fl \a) (catch ClassCastException e :cce))
(try (fd \a) (catch ClassCastException e :cce))
(try (fl nil) (catch NullPointerException e :npe))
(try (fd nil) (catch NullPointerException e :npe))
