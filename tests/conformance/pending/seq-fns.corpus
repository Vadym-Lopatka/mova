;; seq-fns.corpus -- functions Clojure's core seq/collection surface has
;; that mova is missing entirely (one form each, from the audited list),
;; arity gaps on functions that DO exist (partition's step/pad arities,
;; get/contains?/nth type coverage, negative take/drop), and sort/sort-by
;; STABILITY: Clojure's sort is guaranteed stable (equal-key elements keep
;; their relative input order); mova's sort with an EXPLICIT comparator
;; (2-arg sort, or 3-arg sort-by) silently REVERSES same-key runs instead
;; -- pinned at the bottom with several tie shapes. mova's default (no
;; explicit comparator) sort-by/sort was independently verified stable on
;; every shape tried and is NOT in this file (see main corpus additions).
;; All forms self-contained (no cross-form session state).
;;
;; compat/s4-sorted-vecof (2026-08-20): `key`/`val`/`find` now exist
;; (added for sorted-map's own map-entry choke points) -- moved to
;; tests/conformance/corpus/collections.corpus.
;;
;; compat/c10-datastructures (2026-08-21): `partition`'s step/pad arities
;; (3- and 4-arg) now exist -- both moved to tests/conformance/corpus/
;; seqs.corpus.

(tree-seq seq? seq (list 1 (list 2 3) 4))
(bounded-count 3 (range 100))

;; -- arity gaps on functions that DO exist --
(get "hello" 1)
(contains? "hello" 1)
(contains? "hello" 100)
(nth {:a 1} 0)

;; -- sort/sort-by stability: explicit comparator reverses same-key runs --
(sort-by first < (map vector [3 1 3 2 3 1] [:a :b :c :d :e :f]))
(sort (fn [a b] (< (first a) (first b))) [[3 :a] [1 :b] [3 :c] [2 :d] [3 :e] [1 :f]])
(sort-by first > [[1 :a] [2 :b] [1 :c] [2 :d]])
(sort-by first > [[3 :a] [1 :b] [3 :c] [2 :d] [3 :e] [1 :f]])
