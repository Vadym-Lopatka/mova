;; mova-test-helper-shim.mova -- a minimal clojure.test-helper workalike,
;; written in mova itself, materialized as clojure/test_helper.mova by
;; tools/clojure-suite-run.bb (mirroring how mova-test-shim.mova is
;; materialized as clojure/test.mova) so vendored files that `(:require
;; [clojure.test-helper ...])` or `(:use clojure.test-helper)` can resolve
;; the namespace on the module path.
;;
;; THIS IS TEST INFRASTRUCTURE, NOT PART OF THE SHIPPED LANGUAGE -- kept
;; out of core/, same as mova-test-shim.mova.
;;
;; Upstream: .oracle/clojure-src/test/clojure/test_helper.clj -- read but
;; NOT transliterated (it is JVM-interop-heavy: java.io.PrintWriter /
;; java.io.StringWriter, .getDeclaredField/.setAccessible reflection,
;; Throwable/.getCause chains, dynamic vars + binding, in-ns). Every
;; capability claim below was individually probed against a live mova
;; before being written, never quoted from memory of what Clojure does
;; (see tests/clojure-suite/SHIM-LIMITS.md's "test-helper" section for
;; the exact probe commands and their outputs).
;;
;; What mova is confirmed MISSING that upstream test-helper.clj needs:
;;   - no `in-ns` FUNCTION     -> `eval-in-temp-ns` IS now implemented
;;                                 below (S7), but not via `in-ns` --
;;                                 that symbol is still confirmed
;;                                 unresolvable ("Unable to resolve
;;                                 symbol: in-ns") -- see that macro's own
;;                                 doc comment for the `(eval (list 'ns
;;                                 sym))` workaround this shim uses
;;                                 instead, built on the `ns` SPECIAL FORM
;;                                 (which mova does have) plus `eval`
;;                                 (which mova also has, confirmed
;;                                 working: `(eval '(+ 1 2))` => `3`).
;;   - no REAL `*err*` dynamic var -> mova itself still has no
;;                                 interpreter-level `*err*` that a real
;;                                 `print`/`println` writes through
;;                                 (confirmed: still unresolvable as a
;;                                 bare mova builtin). S5 adds a shim-OWN
;;                                 `*err*` + `ts-err-write` writer pair
;;                                 (mova-test-shim.mova, next to
;;                                 `run-test`) that THIS file's
;;                                 `with-err-string-writer` builds on --
;;                                 good enough to capture what this
;;                                 shim's OWN `run-test` diagnostics
;;                                 write, but NOT a real stderr capture.
;;                                 W4-SHIM: `with-err-print-writer` IS now
;;                                 provided too (next to `with-err-string-
;;                                 writer` below) -- measured that upstream's
;;                                 two macros differ only in which java.io
;;                                 Writer class wraps `*err*`, never in
;;                                 what a caller can observe, so this shim
;;                                 reuses the exact same atom-based
;;                                 mechanism for both (see that macro's own
;;                                 comment). `should-print-err-message` and
;;                                 `should-not-reflect` ARE now provided
;;                                 (wave-C small sweep item 3, and C3a
;;                                 respectively, both next to `with-err-
;;                                 string-writer` below) -- not because
;;                                 the real stderr capture gap closed, but
;;                                 because leaving either unresolvable was
;;                                 crashing unrelated assertions AFTER
;;                                 their mid-deftest call sites
;;                                 (`should-print-err-message`: ~49 in
;;                                 control.clj; `should-not-reflect`: 39,
;;                                 also control.clj's `test-case`, plus 2
;;                                 more in special.clj); both now run for
;;                                 real against this shim's own (non-JVM)
;;                                 `*err*` and either fail or pass
;;                                 honestly, see each macro's own comment.
;;                                 Both exist upstream to wrap ARBITRARY
;;                                 code that might call real
;;                                 `.printStackTrace`/`binding
;;                                 [*out* *err*]`-style JVM output this
;;                                 shim's `*err*` was never wired to
;;                                 intercept. `should-not-reflect`'s whole
;;                                 premise (detecting reflection warnings)
;;                                 doesn't apply to a non-JVM host at all
;;                                 -- mova has no reflection -- so its
;;                                 checks pass honestly rather than
;;                                 approximating anything (see its own
;;                                 comment below).
;;   - no `alter-var-root`,    -> set-var-roots / with-var-roots* (the
;;     no `intern`                FUNCTION versions, which take a runtime
;;                                 MAP of {var val} pairs built by the
;;                                 caller) cannot be implemented: mova's
;;                                 `set!` requires a LITERAL symbol at the
;;                                 call site (confirmed: passing a Var
;;                                 value through a helper fn and calling
;;                                 `(set! v newval)` there errors "Unable
;;                                 to resolve symbol: v" -- set! is not
;;                                 resolving a runtime value, it wants a
;;                                 literal name lexically), so there is no
;;                                 way to recover "the symbol to redefine"
;;                                 from an arbitrary runtime Var value.
;;                                 `intern` (which could have sidestepped
;;                                 this) also does not exist (confirmed).
;;   - no `.getCause`/         -> `causes` (walks a Throwable's cause
;;     `ex-cause`                 chain) cannot be implemented at all;
;;                                 NOT exported here (documented, not
;;                                 stubbed with a fake single-element
;;                                 chain that would misrepresent what it
;;                                 does)
;;   - no reflection           -> `get-field` (private/protected field
;;     (.getDeclaredField /       access via reflection) cannot be
;;     .setAccessible)            implemented; NOT exported here
;;
;; What IS provided, and how:
;;   - platform-newlines : identity (see below -- exact on this platform,
;;                          not an approximation)
;;   - exception          : (throw ...), same observable shape as upstream
;;                          to every catcher in this corpus (all untyped)
;;   - with-var-roots     : a MACRO (not with-var-roots*/set-var-roots),
;;                          built on `with-redefs` (landed M4b) -- requires
;;                          its root-map to be a LITERAL map of `{#'sym
;;                          val ...}` pairs at the macro call site (which
;;                          is how every real upstream usage writes it),
;;                          because with-redefs itself needs literal
;;                          symbols, same constraint as `set!` above.
;;
;; `thrown-with-cause-msg?` and `fails-with-cause?` are NOT defined here:
;; upstream implements them via `defmethod assert-expr`, i.e. as `is`
;; assertion SHAPES, not as ordinary test-helper functions/macros. mova
;; has no defmulti/defmethod, and `is` itself is a hardcoded macro living
;; in mova-test-shim.mova (not this file) -- so those two are implemented
;; as additional special-cased cond branches directly inside THAT macro,
;; right next to the `thrown?` case they are structurally closest to. See
;; mova-test-shim.mova's `is` macro and SHIM-LIMITS.md for the class-blind,
;; message-if-accessible approximation used there.

;; ==================== platform-newlines ====================
;; Upstream: (let [nl (System/getProperty "line.separator")] (defn
;; platform-newlines [s] (.replace s "\n" nl))). mova has neither
;; `System/getProperty` nor `.replace` string interop (both confirmed:
;; "Unable to resolve symbol"). This is NOT a guess standing in for the
;; missing interop, though: the vendored suite's own oracle
;; (tools/oracle-census.sh) is hard-pinned to run against a real Clojure
;; 1.13.0-alpha6 JVM on THIS machine (macOS), and on every JVM on every
;; macOS/Linux host `line.separator` is "\n" (only Windows JVMs report
;; "\r\n"). Replacing "\n" with "\n" in a string is the identity function,
;; EXACTLY -- a provable simplification once the platform is macOS/Linux,
;; not an approximation of what platform-newlines does here. Measured
;; directly against the pinned oracle version:
;;   clj-nrepl-eval -p <repl-port> '(System/getProperty "line.separator")'
;;   => "\n"
(defn platform-newlines [s] s)

;; ==================== exception ====================
;; Upstream: (defn exception [] (throw (new Exception "..."))) -- used to
;; assert a code path is unreachable. mova's `throw` accepts any value
;; (confirmed: `(throw "a string")` works, caught by an untyped `catch`);
;; there is no `Exception.` constructor (confirmed: "Unable to resolve
;; symbol: Exception."), so this throws a plain string instead of a typed
;; Exception object. Every catcher in this corpus is untyped anyway (mova
;; has no typed catch), so this loses nothing observable: callers only
;; ever see "something was thrown, with this message", exactly like
;; upstream's Exception would look to an untyped catch.
(defn exception []
  (throw "Exception which should never occur"))

;; ==================== with-var-roots ====================
;; Upstream `with-var-roots` (macro) delegates to `with-var-roots*`
;; (function) + `set-var-roots` (function) + `alter-var-root`, none of
;; which mova can express (see the missing-capability list above). But
;; `with-var-roots` ITSELF is a macro, and every real usage in this corpus
;; (and upstream) writes its root-map as a LITERAL `{#'sym val ...}` map
;; at the call site -- e.g. `(with-var-roots {#'clojure.core/global-
;; hierarchy (make-hierarchy)} ...)`. Because a macro receives that map as
;; UNEVALUATED DATA (confirmed by probe: a map literal `{#'foo 2}` reads,
;; before evaluation, as `{(var foo) 2}` -- the key is the literal form
;; `(var foo)`, not a runtime Var value), the symbol to redefine IS
;; available at macro-expansion time even though it is NOT available at
;; runtime from an arbitrary Var value. That is exactly the shape
;; `with-redefs` needs. So: walk the map's keys at macro-expansion time,
;; require each one to be exactly `(var sym)` (i.e. written as `#'sym` in
;; source), pull out `sym`, and rewrite the whole form as a single
;; `with-redefs` call over `[sym1 val1 sym2 val2 ...]`.
;;
;; This does NOT cover a root-map built at runtime and passed in through a
;; variable (e.g. `(with-var-roots some-runtime-map ...)`) -- that shape
;; is rejected with a loud macro-expansion-time error naming the
;; unsupported key, rather than silently doing nothing or guessing. No
;; usage in this corpus does that (verified: the corpus's one call site,
;; multimethods.clj, uses a literal map). set-var-roots / with-var-roots*
;; (the function versions, which by definition only ever see already-
;; evaluated runtime maps) are consequently NOT exported here at all --
;; there is no literal-map trick available to a plain function.
;; ==================== eval-in-temp-ns ====================
;; Upstream: `(binding [*ns* *ns*] (in-ns (gensym)) (clojure.core/use
;; 'clojure.core) (eval '(do ~@forms)))` -- switch to a fresh, disposable
;; namespace, evaluate `forms` there (quoted, so only globally-resolvable
;; symbols work -- no closure over the macro call site's locals, matching
;; upstream exactly), and restore `*ns*` on the way out via `binding`'s own
;; unwind.
;;
;; S7 (measured): mova has no `in-ns` FUNCTION (confirmed unresolvable),
;; but it DOES have the `ns` SPECIAL FORM and a working `eval` -- and
;; `(eval (list 'ns some-sym))` genuinely switches the interpreter's
;; current namespace at runtime (measured: `(eval (list 'ns (gensym)))`
;; then `(ns-name *ns*)` reports the new generated name; a `def` evaluated
;; afterward does NOT leak back into the original ns -- measured directly,
;; `resolve` finds it nil there). `clojure.core` fns are reachable in the
;; fresh namespace with no separate `use` step needed (measured: `inc`/`+`
;; resolve immediately after switching), so this shim skips the `(use
;; 'clojure.core)` call upstream makes -- there being nothing here it
;; would add.
;;
;; What this shim does NOT copy from upstream: restoring the original
;; namespace via `binding [*ns* *ns*]`. That was tried first and measured
;; BROKEN in a way serious enough to abandon outright: `*ns*`'s dynamic
;; `binding` and the `ns` special form's actual namespace-switching state
;; are NOT kept in sync in mova (measured: inside a `(binding [*ns* *ns*]
;; (eval (list 'ns g)) ...)` block, `*ns*` still PRINTS the pre-switch
;; value while the switch has already silently taken effect underneath;
;; worse, once the `binding` block exits, `*ns*` is left on the NEW
;; namespace instead of being restored to the original one -- backwards
;; from what `binding` promises). Relying on that would leak the last
;; `eval-in-temp-ns` call's throwaway namespace into every deftest that
;; runs afterward in the same file, corrupting unrelated symbol
;; resolution -- unacceptable for a helper meant to be a no-op outside its
;; own dynamic extent. Fixed by managing the restore BY HAND instead of
;; trusting `binding`: capture `(ns-name *ns*)` before switching, and
;; `(eval (list 'ns orig))` back to it in a `finally` (so the restore runs
;; whether `forms` returns normally or throws -- measured directly, both
;; paths land back on the original namespace). This is a real, load-
;; bearing behavioral difference from upstream's `binding`-based restore,
;; not a style choice -- see SHIM-LIMITS.md if this needs revisiting
;; alongside a real fix to `*ns*`/`binding` interaction (out of scope
;; here: that is core interpreter state, not test-helper surface).
(defmacro eval-in-temp-ns [& forms]
  `(let [orig# (ns-name *ns*)]
     (try
       (eval (list 'ns (gensym)))
       (eval '(do ~@forms))
       (finally
         (eval (list 'ns orig#))))))

;; ==================== with-err-string-writer ====================
;; Upstream: `(with-open [w (StringWriter.)] (binding [*err* w] ~@body)
;; (str w))`. Built on `*err*`/`ts-err-write` (mova-test-shim.mova, next
;; to `run-test` -- see that file's own comment for exactly what this
;; writer does and doesn't capture): binds `*err*` to a fresh atom for
;; the dynamic extent of `body`, then returns whatever got `swap!`ed onto
;; it as a string. Relies on mova's macroexpansion being non-hygienic
;; across namespaces (module doc above) the same way `deftest` etc. do:
;; `*err*` here resolves, at the point this macro's expansion actually
;; runs, against whatever namespace the CALLER spliced this shim into
;; (every vendored file gets both shims spliced into its own namespace --
;; see tools/clojure-suite-run.bb's module doc), where `*err*` is
;; guaranteed defined because mova-test-shim.mova defines it and both
;; shims are always spliced together, in the same order, everywhere this
;; runner assembles a file.
(defmacro with-err-string-writer [& body]
  `(let [w# (atom "")]
     (binding [*err* w#]
       ~@body)
     @w#))

;; ==================== with-err-print-writer ====================
;; W4-SHIM (2026-08-21): closes `def.clj`'s `non-dynamic-warnings` deftest
;; ("Unable to resolve symbol: with-err-print-writer"). Upstream
;; (test_helper.clj:99): `(let [s# (StringWriter.) p# (PrintWriter. s#)]
;; (binding [*err* p#] ~@body) (str s#))` -- the ONLY observable difference
;; from `with-err-string-writer` (test_helper.clj:109, directly above) is
;; which java.io Writer class `*err*` gets bound to; both macros run
;; `body`, then return whatever got written to `*err*` as a plain string
;; (measured directly against the pinned oracle: writing the same text
;; through a `PrintWriter`-wrapped `StringWriter` vs. a bare `StringWriter`
;; produces byte-identical `(str s#)` output -- the two upstream macros are
;; therefore observationally identical to any caller, confirmed by reading
;; every vendored call site: none inspects anything Writer-specific like
;; flush timing or encoding, all of them just want the captured text).
;; mova has neither Writer class (confirmed unresolvable, same "no REAL
;; `*err*` dynamic var" gap this module's header describes) and this
;; shim's own `*err*` is a single hand-rolled atom-capture mechanism (see
;; `with-err-string-writer`'s own doc just above) with no Writer-flavor
;; distinction to preserve in the first place -- so this is not an
;; approximation collapsing two upstream behaviors into one, it is
;; reproducing the one behavior both upstream macros already share.
;; Implemented as a literal reuse of `with-err-string-writer`'s own
;; expansion (same atom, same `binding`, same `@w#` return) rather than a
;; separate mechanism, since there is nothing left to differentiate.
(defmacro with-err-print-writer [& body]
  `(let [w# (atom "")]
     (binding [*err* w#]
       ~@body)
     @w#))

;; ==================== should-print-err-message =============
;; Upstream (test_helper.clj:99-104): `(defmacro should-print-err-message
;; [msg-re form] `(binding [*warn-on-reflection* true] (is (re-matches
;; ~msg-re (with-err-string-writer (eval-in-temp-ns ~form)))) (is
;; (re-matches ~msg-re (with-err-print-writer (eval-in-temp-ns
;; ~form))))))` -- turns reflection warnings on, evaluates `form` in a
;; fresh temp ns, and asserts the FULL captured `*err*` text `re-matches`
;; `msg-re`, checked TWICE (once per writer flavor).
;;
;; W4B-WARNINGS (2026-08-21): this module's own header used to say
;; `should-print-err-message` "FAILS HONESTLY" because nothing consulted
;; `*warn-on-reflection*` at all -- an OLDER version of this macro (see
;; git history) neither bound the flag nor routed through
;; `eval-in-temp-ns`, and used `re-find` instead of `re-matches`, so it
;; degraded to "reuses this file's own `with-err-string-writer`, which
;; captures an empty string for any mova program, so the check below
;; fails honestly". That gap is what `crate::reflwarn` (`src/reflwarn.rs`)
;; closes: mova now genuinely walks a `defn`/`fn` body's dot-forms/
;; ctor-forms/static-calls under `*warn-on-reflection*` and writes a real
;; `Reflection warning, <path>:<line>:<col> - <reason>.` line through
;; `*err*` the SAME route the `def`-shadow warning already proved works
;; (`Interp::shadow_warning` -> `write_shim_err`). This macro is now a
;; faithful transcription of upstream's OWN shape (binding + eval-in-
;; temp-ns + re-matches + both writer flavors) rather than a documented
;; gap -- see `tests/clojure-suite/SHIM-LIMITS.md`'s "should-print-err-
;; message" section for exactly which rows this closes (the 9 `rt.clj`
;; reflection rows) and which stay open (`control.clj`'s 2 case-codegen
;; "Performance warning" rows -- real JVM tableswitch/hash-bucket
;; properties mova's `case` genuinely does not have; `*warn-on-reflection*`
;; now being real for these two call sites too changes nothing about
;; them, since neither body contains a dot-form/ctor-form/static-call for
;; `crate::reflwarn` to have an opinion about -- they still fail exactly
;; as before, now via two `re-matches` misses instead of one `re-find`
;; miss, same net "not passing", never a regression).
(defmacro should-print-err-message [msg-re & body]
  `(binding [*warn-on-reflection* true]
     (is (re-matches ~msg-re (with-err-string-writer (eval-in-temp-ns ~@body))))
     (is (re-matches ~msg-re (with-err-print-writer (eval-in-temp-ns ~@body))))))

;; ==================== should-not-reflect ====================
;; Upstream (test_helper.clj:126): `(defmacro should-not-reflect [form]
;; \`(binding [*warn-on-reflection* true] (is (nil? (re-find #"^Reflection
;; warning" (with-err-string-writer (eval-in-temp-ns ~form))))) (is (nil?
;; (re-find #"^Reflection warning" (with-err-print-writer (eval-in-temp-ns
;; ~form)))))))` -- turns on reflection warnings and asserts NONE were
;; printed, checked twice (once via `with-err-string-writer`, once via
;; `with-err-print-writer`, upstream's two independent `*err*` plumbing
;; paths -- see those two macros' own doc comments above).
;;
;; This shim drops the `(binding [*warn-on-reflection* true] ...)` wrapper
;; (confirmed unresolvable: mova has no `*warn-on-reflection*` var to bind,
;; same "no reflection at all" gap `with-err-print-writer` is NOT
;; implemented for, see this module's header) and uses
;; `with-err-string-writer` for BOTH `is` clauses instead of one-of-each,
;; since `with-err-print-writer` is not exported here (only
;; `with-err-string-writer` is -- see the header's "no REAL `*err*` dynamic
;; var" entry). This was the exact missing symbol that aborted
;; control.clj's `test-case` deftest at assertion 33/75 ("Unable to resolve
;; symbol: should-not-reflect") and cost special.clj's
;; `typehints-retained-destructuring` 2 more (measured 2026-08-21).
;;
;; Both `is` clauses still pass HONESTLY, not as a rubber stamp: mova has
;; no reflection at all (module header, "no reflection ->
;; .getDeclaredField/.setAccessible"), so this shim's own
;; `with-err-string-writer` -- built on the shim's own `*err*`, which mova
;; code never writes to -- genuinely captures an empty string for any
;; `form` here, and `(re-find #"^Reflection warning" "")` is genuinely
;; `nil` for real, exactly the same "no false stamp, just a check that
;; happens to always hold on a non-JVM host" shape `should-print-err-
;; message`'s own comment above documents for its mirror-image case.
;; `form` still runs for real, exactly like upstream, in case a corpus
;; author ever relies on its side effects.
(defmacro should-not-reflect [form]
  `(do (is (nil? (re-find #"^Reflection warning" (with-err-string-writer (eval-in-temp-ns ~form)))))
       (is (nil? (re-find #"^Reflection warning" (with-err-string-writer (eval-in-temp-ns ~form)))))))

;; ==================== temp-ns ====================
;; Upstream: `(defn temp-ns [& uses] (binding [*ns* *ns*] (in-ns (gensym))
;; (apply clojure.core/use 'clojure.core uses) *ns*))` -- create a fresh,
;; disposable namespace and return it. rt.clj's `ns-intern-policies` calls
;; it with NO `uses` args, and every one of its own call sites uses the
;; returned namespace only through explicit-`ns`-argument functions
;; (`intern`, `.refer`, `ns-resolve`) -- never implicitly through `*ns*` --
;; so this shim drops the `uses`/`clojure.core/use` step entirely (nothing
;; here would need it; `clojure.core` fns already resolve in a fresh ns
;; with no separate `use`, exactly as `eval-in-temp-ns`'s own doc above
;; measured).
;;
;; S7 (measured, in-ns now a real fn -- see that builtin's own doc): does
;; NOT copy upstream's `binding [*ns* *ns*]` wrapper. `eval-in-temp-ns`
;; above already found that pattern broken for restoring `*ns*` correctly
;; around an `in-ns`/`ns`-style switch (see its own doc for the measured
;; symptom); the same "manage the restore by hand" fix applies here --
;; capture the CURRENT ns name, switch to a gensym'd one (which creates and
;; returns it), switch straight back, and hand back the now-registered
;; (but no-longer-current) namespace value via `find-ns`. Every later use
;; of that value goes through an explicit-ns-argument fn, so it being
;; non-current is a non-issue -- unlike `eval-in-temp-ns`, there is no
;; `forms` body run INSIDE the temp ns's dynamic extent here at all.
(defn temp-ns []
  (let [orig (ns-name *ns*)
        g (gensym)]
    (in-ns g)
    ;; upstream: `(apply clojure.core/use 'clojure.core uses)`; `in-ns` alone refers no core
    (clojure.core/refer 'clojure.core)
    (in-ns orig)
    (find-ns g)))

(defmacro with-var-roots [root-map & body]
  (let [bindings
        (vec (mapcat
              (fn [entry]
                (let [k (first entry)
                      v (second entry)]
                  (if (and (seq? k) (= (first k) 'var))
                    [(second k) v]
                    (throw (str "with-var-roots: unsupported root-map key " (pr-str k)
                                " -- only literal #'sym keys are supported here"
                                " (mova's with-redefs, which this is built on,"
                                " needs a literal symbol at the call site, not a"
                                " runtime Var value; see SHIM-LIMITS.md)")))))
              (seq root-map)))]
    `(with-redefs ~bindings ~@body)))
