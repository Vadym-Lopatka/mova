;; raw-chan.mova -- bench floor: N messages through ONE bare 1000-buf
;; channel, one producer thread, this thread as consumer. No flow engine
;; involved at all -- every flow-* scenario's per-message overhead is
;; measured relative to this substrate cost. Self-timing: prints
;; "<name> <msgs> <ms> <msg/s>" on one line, per bench/run.sh's contract.
;;
;;   ./target/release/mova bench/raw-chan.mova

(def N 800000)
(def ch (chan 1000))
(def t0 (time-ms))

(thread
  (loop [i 0]
    (when (< i N)
      (>!! ch i)
      (recur (inc i))))
  (close! ch))

(loop [n 0]
  (let [v (<!! ch)]
    (if (nil? v)
      (let [elapsed (max 1 (- (time-ms) t0))
            rate (quot (* n 1000) elapsed)]
        (println "raw-chan" n elapsed rate))
      (recur (inc n)))))
