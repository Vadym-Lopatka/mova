;; reuse-conj-100.mova -- Perceus-lite phase 1 (v0.5) A/B shape: the vector
;; twin of reuse-assoc-100.mova, crossing PVEC_SMALL_MAX (16) for N>16.
;; Same control caveat: `v` is a live closure binding when `conj` runs.
;;
;;   ./target/release/mova bench/reuse-conj-100.mova

(def N 100)
(def R 20000)
(def t0 (time-ms))
(def checksum
  (loop [r 0 acc 0]
    (if (< r R)
      (recur (inc r) (+ acc (count (reduce (fn [v i] (conj v i)) [] (range N)))))
      acc)))
(def elapsed (max 1 (- (time-ms) t0)))
(def ops (* N R))
(println "reuse-conj-100" ops elapsed (quot (* ops 1000) elapsed))
