;; flow-4hop-native.mova -- the native-step tier's UNFUSED 4-hop row (N4, see
;; NATIVE-STEP-DESIGN.md), the "before" half of the step-comp fusion
;; comparison: source -> 3x (flow/step-passthrough), each its OWN proc (its
;; own OS thread, its own promoted run_proc_fast loop, its own inter-proc
;; channel handoff) -> a native sink-deliver. Every hop is CLOSED (zero
;; interp/msg), so this isolates the engine's own per-hop overhead (proc
;; dispatch, channel sync, control checks) with no interpreter cost
;; anywhere in the loop -- the fairest possible baseline for
;; flow-comp-native.mova's fused version of the exact same topology.
;;
;;   gen -> pt1 -> pt2 -> pt3 -> sink   (5 procs, 5 OS threads)
;;
;;   ./target/release/mova bench/flow-4hop-native.mova

(def N 1000000)
(def done (promise))
(def tick (chan 1024))

(def fl (flow/create-flow
         {:procs {:gen {:proc (flow/process (flow/step-source tick))}
                  :p1 {:proc (flow/process (flow/step-passthrough))}
                  :p2 {:proc (flow/process (flow/step-passthrough))}
                  :p3 {:proc (flow/process (flow/step-passthrough))}
                  :sink {:proc (flow/process (flow/step-sink-deliver N done))}}
          :conns [[[:gen :out] [:p1 :in]]
                  [[:p1 :out] [:p2 :in]]
                  [[:p2 :out] [:p3 :in]]
                  [[:p3 :out] [:sink :in]]]}))

(def t0 (time-ms))
(flow/start fl)
(flow/resume fl)
(flow/feed-range! tick N)
(deref done)
(def elapsed (max 1 (- (time-ms) t0)))
(def rate (quot (* N 1000) elapsed))
(println "flow-4hop-native" N elapsed rate)
(flow/stop fl)
