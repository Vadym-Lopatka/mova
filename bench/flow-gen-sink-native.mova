;; flow-gen-sink-native.mova -- the NATIVE-STEP tier's headline row (N2, see
;; NATIVE-STEP-DESIGN.md). Same topology as bench/flow-gen-sink.mova -- a
;; 2-proc flow `gen ->[out|in]-> sink` whose message source is an external
;; buffer-1024 channel wired in at :init time via
;; `:clojure.core.async.flow/in-ports`, fed by a background producer thread,
;; with the sink delivering a promise on the Nth message -- but built from
;; native steps instead of `flow/map->step` + interpreted fns:
;;
;;   gen   = (flow/step-source tick)      + (flow/feed-range! tick N)
;;   sink  = (flow/step-sink-deliver N done)
;;
;; Both procs qualify for promotion (single in-port, <=1 out-port, no
;; ::flow/input-filter, native step-fn carrying a StepFactory), so each runs
;; `run_proc_fast` with ZERO interpreter entry per message; the feeder is
;; native too (the interpreted `(future (loop ... (>!! tick i)))` of
;; flow-gen-sink.mova alone caps that scenario at interpreter dispatch rate,
;; so it could never expose the engine's own ceiling).
;;
;; NEVER compare this row against jank's portable ladder or against
;; bench/flow-gen-sink.mova's number as if they measured the same thing:
;; that one measures interpreted per-message user code, this one measures
;; the engine floor with the user code compiled into the runtime. N is 10x
;; that scenario's for a comparable wall time.
;;
;; A/B the fast path itself with the kill switch (same binary, same script:
;; the steps' 4-arity shells are implemented BY the same FastStep code, so
;; everything still runs, just through the generic interpreted-facing path):
;;
;;   ./target/release/mova bench/flow-gen-sink-native.mova
;;   MOVA_NO_FASTSTEP=1 ./target/release/mova bench/flow-gen-sink-native.mova

(def N 2000000)
(def done (promise))
(def tick (chan 1024))

(def fl (flow/create-flow
         {:procs {:gen {:proc (flow/process (flow/step-source tick))}
                  :sink {:proc (flow/process (flow/step-sink-deliver N done))}}
          :conns [[[:gen :out] [:sink :in]]]}))

(def t0 (time-ms))
(flow/start fl)
(flow/resume fl)
(flow/feed-range! tick N)
(deref done)
(def elapsed (max 1 (- (time-ms) t0)))
(def rate (quot (* N 1000) elapsed))
(println "flow-gen-sink-native" N elapsed rate)
(flow/stop fl)
